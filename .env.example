# Copie ce fichier en .env.local et colle les deux lignes de ton projet Supabase
# (bouton Connect > Framework > Next.js > onglet .env.local).
# Sur Vercel, ajoute les deux mêmes variables dans Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# L'ancien nom NEXT_PUBLIC_SUPABASE_ANON_KEY fonctionne aussi.

# Facultatif : URL du tableau de bord si elle vit ailleurs que /dashboard
# NEXT_PUBLIC_DASHBOARD_URL=https://app.merry.fr/dashboard

# Facultatif : adresse du site vitrine (logo et croix « Retour au site »)
# NEXT_PUBLIC_SITE_URL=https://www.merry.fr

# Facultatif : lecture des listes d'invités (photos, PDF) par l'IA, côté serveur uniquement
# ANTHROPIC_API_KEY=
# MERRY_AI_MODEL=claude-sonnet-5-5
# Facultatif : modèle plus rapide pour les tableaux et le texte collé
# MERRY_AI_MODEL_FAST=

# Facultatif : envoi automatique des invitations d'organisateurs par mail (resend.com).
# Sans cette clé, « Envoyer par mail » ouvre la messagerie de l'ordinateur comme avant.
# RESEND_API_KEY=
# Expéditeur : une adresse d'un domaine vérifié dans Resend (ex. Merry <invitation@merry.fr>)
# MERRY_MAIL_FROM=
